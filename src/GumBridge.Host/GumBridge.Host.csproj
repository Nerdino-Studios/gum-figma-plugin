<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../samples/GumBridge.Sample/**/*" Exclude="../../samples/GumBridge.Sample/**/bin/**;../../samples/GumBridge.Sample/**/obj/**;../../samples/GumBridge.Sample/**/FontCache/**" Link="SampleTemplate/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../GumBridge.Application/GumBridge.Application.csproj" />
    <ProjectReference Include="../GumBridge.Infrastructure/GumBridge.Infrastructure.csproj" />
  </ItemGroup>
</Project>
