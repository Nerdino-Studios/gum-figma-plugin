{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nerdino.studio/gum-bridge/wire-v1.schema.json",
  "description": "Wire v1 thin selected-root typed frame/text/image snapshot shapes; no publication or conversion.",
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "parentId",
        "type",
        "name",
        "x",
        "y",
        "width",
        "height",
        "visible"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "enum": [
            "FRAME",
            "TEXT",
            "IMAGE"
          ]
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "visible": {
          "type": "boolean"
        },
        "horizontalSizing": { "enum": ["FIXED", "FILL", "HUG"] },
        "verticalSizing": { "enum": ["FIXED", "FILL", "HUG"] },
        "itemSpacing": { "type": "number", "minimum": 0 },
        "paddingLeft": { "type": "number", "minimum": 0 },
        "paddingRight": { "type": "number", "minimum": 0 },
        "paddingTop": { "type": "number", "minimum": 0 },
        "paddingBottom": { "type": "number", "minimum": 0 },
        "counterAxisAlignItems": { "enum": ["MIN", "CENTER", "MAX"] },
        "layoutAlign": { "enum": ["INHERIT", "MIN", "CENTER", "MAX"] },
        "horizontalAnchor": { "enum": ["MIN", "MAX", "CENTER", "STRETCH"] },
        "verticalAnchor": { "enum": ["MIN", "MAX", "CENTER", "STRETCH"] },
        "minWidth": { "type": "number", "minimum": 0 },
        "maxWidth": { "type": "number", "minimum": 0 },
        "minHeight": { "type": "number", "minimum": 0 },
        "maxHeight": { "type": "number", "minimum": 0 },
        "layoutMode": {
          "enum": [
            "NONE",
            "HORIZONTAL",
            "VERTICAL"
          ]
        },
        "clipsContent": {
          "type": "boolean"
        },
        "rotation": { "type": "number" },
        "characters": {
          "type": "string"
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "imageHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "scaleMode": {
          "enum": ["FIT", "FILL", "CROP"]
        },
        "imageTransform": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
        },
        "fontFamily": {
          "$ref": "#/$defs/text"
        },
        "fontStyle": {
          "$ref": "#/$defs/text"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "FRAME"
              }
            }
          },
          "then": {
            "required": [
              "layoutMode",
              "clipsContent"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "characters"
                  ]
                },
                {
                  "required": [
                    "fontSize"
                  ]
                },
                {
                  "required": [
                    "imageHash"
                  ]
                },
                {
                  "required": [
                    "scaleMode"
                  ]
                },
                {
                  "required": [
                    "fontFamily"
                  ]
                },
                {
                  "required": [
                    "fontStyle"
                  ]
                },
                { "required": ["imageTransform"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "TEXT"
              }
            }
          },
          "then": {
            "required": [
              "characters",
              "fontSize",
              "fontFamily",
              "fontStyle"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "layoutMode"
                  ]
                },
                {
                  "required": [
                    "clipsContent"
                  ]
                },
                {
                  "required": [
                    "imageHash"
                  ]
                },
                {
                  "required": [
                    "scaleMode"
                  ]
                },
                { "required": ["itemSpacing"] }, { "required": ["paddingLeft"] }, { "required": ["paddingRight"] },
                { "required": ["paddingTop"] }, { "required": ["paddingBottom"] }, { "required": ["counterAxisAlignItems"] },
                { "required": ["imageTransform"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "IMAGE"
              }
            }
          },
          "then": {
            "required": [
              "imageHash",
              "scaleMode"
            ],
            "allOf": [
              { "if": { "properties": { "scaleMode": { "const": "CROP" } }, "required": ["scaleMode"] },
                "then": { "required": ["imageTransform"] }, "else": { "not": { "required": ["imageTransform"] } } }
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "layoutMode"
                  ]
                },
                {
                  "required": [
                    "clipsContent"
                  ]
                },
                {
                  "required": [
                    "characters"
                  ]
                },
                {
                  "required": [
                    "fontSize"
                  ]
                },
                {
                  "required": [
                    "fontFamily"
                  ]
                },
                {
                  "required": [
                    "fontStyle"
                  ]
                },
                {
                  "required": [
                    "color"
                  ]
                },
                { "required": ["itemSpacing"] }, { "required": ["paddingLeft"] }, { "required": ["paddingRight"] },
                { "required": ["paddingTop"] }, { "required": ["paddingBottom"] }, { "required": ["counterAxisAlignItems"] }
              ]
            }
          }
        }
      ]
    },
    "version": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "additionalProperties": false,
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9-]*(\\.[A-Za-z][A-Za-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "object",
      "required": [
        "schemaVersion",
        "operation"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/version"
        },
        "operation": {
          "$ref": "#/$defs/text"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "allOf": [{
        "if": { "properties": { "schemaVersion": { "properties": { "minor": { "const": 0 } } } } },
        "then": { "properties": { "nodes": { "items": { "not": { "anyOf": [
          { "required": ["horizontalSizing"] }, { "required": ["verticalSizing"] },
          { "required": ["horizontalAnchor"] }, { "required": ["verticalAnchor"] },
          { "required": ["minWidth"] }, { "required": ["maxWidth"] },
          { "required": ["minHeight"] }, { "required": ["maxHeight"] }
        ] } } } } }
      }, {
        "if": { "properties": { "schemaVersion": { "properties": { "minor": { "maximum": 1 } } } } },
        "then": { "properties": { "nodes": { "items": { "not": { "anyOf": [
          { "required": ["itemSpacing"] }, { "required": ["paddingLeft"] }, { "required": ["paddingRight"] },
          { "required": ["paddingTop"] }, { "required": ["paddingBottom"] },
          { "required": ["counterAxisAlignItems"] }, { "required": ["layoutAlign"] },
          { "properties": { "horizontalSizing": { "const": "HUG" } }, "required": ["horizontalSizing"] },
          { "properties": { "verticalSizing": { "const": "HUG" } }, "required": ["verticalSizing"] }
        ] } } } } }
      }],
      "required": [
        "schemaVersion",
        "snapshotId",
        "documentNamespace",
        "selectedRootIds",
        "rootAliases",
        "nodes"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/version"
        },
        "snapshotId": {
          "$ref": "#/$defs/text"
        },
        "documentNamespace": {
          "$ref": "#/$defs/text"
        },
        "selectedRootIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "extractionDiagnostics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "rootAliases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rootId",
              "alias"
            ],
            "additionalProperties": false,
            "properties": {
              "rootId": {
                "$ref": "#/$defs/text"
              },
              "alias": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "required": [
        "schemaVersion",
        "catalogId",
        "revision",
        "controls"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/version"
        },
        "catalogId": {
          "$ref": "#/$defs/text"
        },
        "revision": {
          "$ref": "#/$defs/text"
        },
        "controls": {
          "type": "array",
          "maxItems": 0
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "schemaVersion",
        "code",
        "severity",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/version"
        },
        "code": {
          "$ref": "#/$defs/text"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "$ref": "#/$defs/text"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    }
  }
}
